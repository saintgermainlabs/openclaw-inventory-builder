{
  "url": "https://ubuntu-server.tiger-bushmaster.ts.net/mcp",
  "transport": "streamable-http",
  "headers": {
    "Authorization": "Bearer ${COOLIFY_MCP_TOKEN}"
  },
  "toolFilter": {
    "include": [
      "list_servers",
      "list_applications",
      "list_services",
      "list_databases",
      "get_server",
      "get_application",
      "get_service",
      "get_database",
      "get_server_resources",
      "get_domains",
      "server_resources",
      "server_domains",
      "list_deployments",
      "get_infrastructure_overview",
      "get_version",
      "diagnose_app",
      "diagnose_server",
      "find_issues"
    ]
  }
}
