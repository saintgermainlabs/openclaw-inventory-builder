{
  "command": "npx",
  "args": ["-y", "@hexsleeves/tailscale-mcp-server"],
  "env": {
    "TAILSCALE_API_KEY": "${TAILSCALE_API_KEY}",
    "TAILSCALE_TAILNET": "-",
    "TAILSCALE_ALLOWED_TOOL_RISK": "read"
  },
  "toolFilter": {
    "include": [
      "list_devices",
      "get_tailnet_info",
      "get_network_status",
      "get_version",
      "get_version_info",
      "ping_peer"
    ]
  }
}
